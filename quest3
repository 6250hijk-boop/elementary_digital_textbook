<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quest 3 - 좋은 데이터 선별</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Pretendard', sans-serif; }
    body { background-color: #F0F4F8; color: #2C3E50; padding: 20px; }
    .card { max-width: 650px; margin: 0 auto; background: white; border-radius: 20px; padding: 25px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
    h2 { color: #00796B; margin-bottom: 12px; }
    .guide-box { background: #E0F2F1; border-left: 5px solid #009688; padding: 12px; border-radius: 8px; margin-bottom: 18px; font-size: 14px; line-height: 1.5; }
    .choice-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
    .choice-item { border: 2px solid #E0E0E0; border-radius: 12px; padding: 14px; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 10px; }
    .choice-item:hover { border-color: #009688; background: #F4FAF9; }
    .choice-item input { transform: scale(1.3); }
    .btn-submit { width: 100%; padding: 14px; background: #009688; color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: bold; cursor: pointer; }
    .btn-back { display: inline-block; margin-bottom: 12px; color: #666; text-decoration: none; font-size: 14px; font-weight: bold; }
  </style>
</head>
<body>

<div class="card">
  <a href="main.html" class="btn-back">⬅️ 메인 월드로 돌아가기</a>
  <h2>📸 [Quest 3] AI 학습을 위한 좋은 데이터 선별</h2>
  <div class="guide-box">AI가 사진을 보고 정확하게 배우기 위해 가장 적합한 <strong>'좋은 데이터 사진'</strong>의 조건을 골라보세요! (모두 선택)</div>

  <div class="choice-group">
    <label class="choice-item">
      <input type="checkbox" name="goodData" value="선명하고 조명이 적절한 사진">
      <span>☀️ 그림자가 짙지 않고 물체가 선명하게 나온 사진</span>
    </label>
    <label class="choice-item">
      <input type="checkbox" name="goodData" value="다양한 각도와 배경">
      <span>🔄 한 방향만이 아닌 다양한 각도와 배경에서 찍은 사진</span>
    </label>
    <label class="choice-item">
      <input type="checkbox" name="goodData" value="다른 물체가 너무 많이 섞인 사진">
      <span>❌ 여러 쓰레기가 너무 복잡하게 겹쳐서 가려진 사진</span>
    </label>
    <label class="choice-item">
      <input type="checkbox" name="goodData" value="실제 상태 반영">
      <span>🥫 약간 찌그러지거나 라벨이 떼어진 실제 형태를 반영한 사진</span>
    </label>
  </div>

  <button class="btn-submit" id="submitBtn">선택 완료 및 저장 (⭐ +20점)</button>
</div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getFirestore, collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCdx4xwK3XIzgw_4hFEohnMe64dc4LDB00",
    authDomain: "elemeelementary-textbook.firebaseapp.com",
    projectId: "elemeelementary-textbook",
    storageBucket: "elemeelementary-textbook.firebasestorage.app",
    messagingSenderId: "713149004420",
    appId: "1:713149004420:web:8483273681e16f5a8fa0d1",
    measurementId: "G-TZT282J9E8"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  const studentId = localStorage.getItem("elementary_studentId");
  const studentName = localStorage.getItem("elementary_studentName");

  document.getElementById("submitBtn").addEventListener("click", async () => {
    const selected = Array.from(document.querySelectorAll("input[name='goodData']:checked")).map(el => el.value);

    if (selected.length === 0) {
      alert("적어도 하나 이상의 조건을 선택해주세요!");
      return;
    }

    try {
      await addDoc(collection(db, "quest3_data_conditions"), {
        studentId, studentName, selectedConditions: selected, createdAt: serverTimestamp()
      });

      let score = parseInt(localStorage.getItem("elementary_score") || "10", 10) + 20;
      localStorage.setItem("elementary_score", score.toString());
      alert("🎉 Quest 3 완료! 좋은 데이터 선별 기준을 잘 이해했습니다. (⭐ +20점)");
      window.location.href = "main.html";
    } catch (e) {
      console.error(e);
      alert("저장 실패");
    }
  });
</script>
</body>
</html>
